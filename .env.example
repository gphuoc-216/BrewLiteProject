# Environment Configuration Example for BrewLite

# Database (PostgreSQL)
# Dùng "postgres:5432" khi chạy qua Docker, hoặc "localhost:5432" khi chạy local
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/brewlite_db?schema=public"

# Backend Configuration
PORT=3001
NODE_ENV=development
JWT_SECRET="brewlite_super_secret_jwt_key_2026"
JWT_REFRESH_SECRET="brewlite_refresh_secret_key_2026"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend Configuration
FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
