datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// Vai trò người dùng trong hệ thống (RBAC)
enum Role {
  CUSTOMER // Khách hàng đặt món
  STAFF    // Nhân viên pha chế (Barista)
  ADMIN    // Quản trị viên
}

// Trạng thái tài khoản
enum AccountStatus {
  ACTIVE // Đang hoạt động bình thường
  LOCKED // Bị Admin khóa (bị chặn ngay ở JwtStrategy)
}

// =========================================================================================
// ENUM TRẠNG THÁI ĐƠN HÀNG (ORDER STATE MACHINE - TASK 9 BE & TASK 10.1)
// =========================================================================================
enum OrderStatus {
  PENDING         // Khởi tạo đơn, chờ thanh toán
  PAID            // Đã thanh toán thành công, chờ barista tiếp nhận
  PREPARING       // Barista đang pha chế (không được hủy)
  READY           // Đã pha xong, sẵn sàng phục vụ / chờ lấy
  COMPLETED       // Khách đã nhận đồ uống, hoàn tất đơn
  PAYMENT_FAILED  // Thanh toán thất bại (cho phép thử lại hoặc hủy)
  CANCELLED       // Đơn đã hủy (kích hoạt hoàn kho & điểm nếu đã PAID)
}

enum PaymentStatus {
  SUCCESS
  FAILED
}

enum PaymentMethod {
  WALLET
  CARD
}

enum PromotionType {
  PERCENT
  FIXED
}

enum ReviewStatus {
  VISIBLE
  HIDDEN
  DELETED
}

// 1. TaiKhoan (Account) - Lưu thông tin đăng nhập chung và quyền (role) cho cả 3 đối tượng
model Account {
  id           String        @id @default(uuid()) // Khóa chính UUID
  username     String        @unique              // Tên đăng nhập duy nhất
  passwordHash String                             // Mật khẩu đã băm bằng bcrypt
  role         Role          @default(CUSTOMER)   // Vai trò: CUSTOMER | STAFF | ADMIN
  status       AccountStatus @default(ACTIVE)     // Trạng thái: ACTIVE | LOCKED
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Quan hệ 1-1 tùy chọn tới từng bảng hồ sơ tương ứng với role
  customer Customer?
  staff    Staff?
  admin    Admin?

  @@map("accounts")
}

// 2. KhachHang (Customer) - Hồ sơ khách hàng (quan hệ 1-1 với Account)
model Customer {
  id            String   @id @default(uuid())
  fullName      String
  email         String   @unique
  loyaltyPoints Int      @default(0) // Điểm tích lũy (+1 điểm / 10.000đ khi PAID; thu hồi khi hủy đơn PAID)
  accountId     String   @unique     // @unique đảm bảo 1 Account chỉ gắn 1 Customer
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders  Order[]
  reviews Review[]

  @@map("customers")
}

// 3. NhanVien (Staff / Barista) - Hồ sơ nhân viên pha chế (quan hệ 1-1 với Account)
model Staff {
  id        String   @id @default(uuid())
  fullName  String
  email     String
  accountId String   @unique // @unique đảm bảo 1 Account chỉ gắn 1 Staff
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[] // Danh sách đơn hàng Barista này đã nhận pha chế

  @@map("staffs")
}

// 4. Admin - Hồ sơ quản trị viên (quan hệ 1-1 với Account)
model Admin {
  id        String   @id @default(uuid())
  fullName  String
  email     String
  accountId String   @unique // @unique đảm bảo 1 Account chỉ gắn 1 Admin
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

// 5. SanPham (Product) - Thông tin chung của món uống trong Menu
model Product {
  id          String   @id @default(uuid())
  name        String
  imageUrl    String
  description String?
  category    String   @default("COFFEE") // COFFEE | TEA | FREEZE
  isActive    Boolean  @default(true)     // Admin ẩn/hiện món trên Menu
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants ProductVariant[] // Các biến thể size (S/M/L) & giá
  reviews  Review[]

  @@map("products")
}

// 6. ChiTietSanPham (ProductVariant) - Biến thể kích cỡ & giá hiện hành của món
model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String   // S, M, L
  price     Decimal  @db.Decimal(12, 2) // Giá bán hiện tại (khi tạo đơn sẽ snapshot sang OrderItem.lineTotal)
  topping   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipes    Recipe[]    // Công thức nguyên liệu cần để pha 1 ly biến thể này
  orderItems OrderItem[]

  @@map("product_variants")
}

// 7. ChiTietDonHang (OrderItem) - Chi tiết từng món trong đơn (đóng băng giá & tùy chọn lúc đặt)
model OrderItem {
  id         Int            @id @default(autoincrement())
  orderId    String
  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  quantity   Int                                // Số lượng ly đặt mua
  lineTotal  Decimal        @db.Decimal(12, 2)  // Snapshot thành tiền tại thời điểm đặt = (giá variant + topping) * quantity; không đổi khi Admin sửa giá sau này
  sugarLevel String?        @default("100%")    // Mức đường khách chọn
  iceLevel   String?        @default("100%")    // Mức đá khách chọn
  toppings   Json?                              // Danh sách topping thêm (JSON array) để hiển thị cho Barista & trừ/hoàn kho

  @@map("order_items")
}

// 8. DonHang (Order) - Đơn hàng & trạng thái vòng đời (Order State Machine)
model Order {
  id                   String      @id @default(uuid())
  customerId           String
  customer             Customer    @relation(fields: [customerId], references: [id])
  staffId              String?     // Barista tiếp nhận pha chế (gán nguyên tử khi PAID -> PREPARING)
  staff                Staff?      @relation(fields: [staffId], references: [id])
  promotionId          String?     // Mã giảm giá chính (nếu có)
  promotion            Promotion?  @relation(fields: [promotionId], references: [id])
  secondaryPromotionId String?     // Mã giảm giá cộng dồn thứ 2 (vd: HAPPYHOUR)
  secondaryPromotion   Promotion?  @relation("OrderSecondaryPromotion", fields: [secondaryPromotionId], references: [id])
  status               OrderStatus @default(PENDING)
  discountAmount     Decimal     @default(0) @db.Decimal(12, 2) // Tổng tiền được giảm lúc đặt
  totalAfterDiscount Decimal     @db.Decimal(12, 2)             // Tổng tiền thực thu cố định (không đổi nếu Admin đổi giá món sau này)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  items           OrderItem[]
  payments        Payment[]
  reviews         Review[]
  statusHistories OrderStatusHistory[]

  @@index([customerId])
  @@index([status])
  @@map("orders")
}

// 9. GiaoDichThanhToan (Payment)
// =========================================================================================
// BẢNG PAYMENT: LƯU TRỮ LỊCH SỬ GIAO DỊCH VÀ ĐẢM BẢO TÍNH BẤT BIẾN (IDEMPOTENCY)
// - Mỗi lần thanh toán thành công sẽ tạo 1 bản ghi Payment gắn liền với đơn hàng (orderId).
// - Cột `idempotencyKey String @unique`: Khóa chống trùng lặp thanh toán do Client gửi lên.
//   Nếu Client vô tình bấm đúp hoặc mạng lag gửi lại request với cùng key, Database sẽ chặn 
//   không cho insert trùng nhờ ràng buộc @unique. Backend bắt lỗi này để trả về kết quả cũ.
// =========================================================================================
model Payment {
  id             String        @id @default(uuid())
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  idempotencyKey String        @unique // Khóa Idempotency duy nhất: đảm bảo 1 giao dịch chỉ được tính tiền 1 lần duy nhất
  amount         Decimal       @db.Decimal(12, 2)
  status         PaymentStatus @default(SUCCESS)
  method         PaymentMethod @default(WALLET)
  createdAt      DateTime      @default(now())

  @@index([idempotencyKey])
  @@map("payments")
}

// 10. KhuyenMai (Promotion) - Mã giảm giá / Voucher
model Promotion {
  id            String        @id @default(uuid())
  code          String        @unique              // Mã voucher (vd: BREW10, GIAM20K, HAPPYHOUR)
  name          String
  discountType  PromotionType @default(PERCENT)    // PERCENT (%) hoặc FIXED (VNĐ cố định)
  discountValue Decimal       @db.Decimal(12, 2)   // Giá trị giảm (% hoặc số tiền)
  minOrderValue Decimal       @default(0) @db.Decimal(12, 2) // Giá trị đơn tối thiểu để áp dụng
  quantity      Int                                // Tổng lượt phát hành
  usedCount     Int           @default(0)          // Số lượt đã dùng (tăng khi PAID, giảm khi hủy đơn PAID)
  startDate     DateTime
  endDate       DateTime
  status        String        @default("ACTIVE")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  orders          Order[]
  secondaryOrders Order[] @relation("OrderSecondaryPromotion")

  @@index([code])
  @@map("promotions")
}

// 11. NguyenLieu (Ingredient) - Khóa lạc quan (Optimistic Locking)
// =========================================================================================
// BẢNG INGREDIENT: QUẢN LÝ TỒN KHO NGUYÊN LIỆU VỚI CƠ CHẾ OPTIMISTIC CONCURRENCY CONTROL (OCC)
// - Cột `version Int @default(1)`: Đóng vai trò là số phiên bản của bản ghi nguyên liệu.
// - Khi nhiều đơn hàng thanh toán đồng thời muốn trừ kho cùng 1 nguyên liệu:
//   Hệ thống sẽ chạy câu lệnh: UPDATE ingredients SET stock = stock - qty, version = version + 1
//   WHERE id = $id AND version = $currentVersion AND stock >= qty.
// - Nếu 2 giao dịch cùng đọc version = 1, giao dịch A trừ trước thành công và tăng version lên 2.
//   Giao dịch B cập nhật sau với điều kiện version = 1 sẽ bị thất bại (ảnh hưởng 0 dòng).
//   Lúc này PaymentService sẽ kích hoạt Retry tối đa 3 lần để đọc lại version mới và trừ kho lại.
// =========================================================================================
model Ingredient {
  id            String   @id @default(uuid())
  name          String
  unit          String
  stockQuantity Decimal  @db.Decimal(12, 2)
  version       Int      @default(1) // Số phiên bản phục vụ Khóa Lạc Quan (Optimistic Locking)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  recipes     Recipe[]
  importItems ImportReceiptItem[]

  @@map("ingredients")
}

// 12. CongThuc (Recipe) - Định mức nguyên liệu để pha 1 ly ProductVariant
model Recipe {
  id               String         @id @default(uuid())
  variantId        String
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  ingredientId     String
  ingredient       Ingredient     @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantityRequired Decimal        @db.Decimal(12, 2) // Lượng nguyên liệu tiêu hao cho 1 ly (dùng tính số ly tối đa & trừ kho)

  @@unique([variantId, ingredientId])
  @@map("recipes")
}

// 13. NhaCungCap (Supplier) - Nhà cung cấp nguyên liệu cho kho
model Supplier {
  id        String   @id @default(uuid())
  name      String
  phone     String
  address   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  importReceipts ImportReceipt[]

  @@map("suppliers")
}

// 14. PhieuNhap (ImportReceipt) - Phiếu nhập kho từ nhà cung cấp (Admin tạo)
model ImportReceipt {
  id          String   @id @default(uuid())
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  importDate  DateTime @default(now())
  totalAmount Decimal  @db.Decimal(12, 2)

  items ImportReceiptItem[]

  @@map("import_receipts")
}

// 15. ChiTietPhieuNhap (ImportReceiptItem) - Từng nguyên liệu nhập trong phiếu (tăng stockQuantity)
model ImportReceiptItem {
  id           String        @id @default(uuid())
  receiptId    String
  receipt      ImportReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient    @relation(fields: [ingredientId], references: [id])
  quantity     Decimal       @db.Decimal(12, 2) // Số lượng nhập thêm (> 0)
  unitPrice    Decimal       @db.Decimal(12, 2)
  lineTotal    Decimal       @db.Decimal(12, 2)

  @@map("import_receipt_items")
}

// 16. DanhGia (Review) - Đánh giá 1-5 sao của khách sau khi đơn COMPLETED
model Review {
  id         String       @id @default(uuid())
  customerId String
  customer   Customer     @relation(fields: [customerId], references: [id])
  productId  String
  product    Product      @relation(fields: [productId], references: [id])
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id])
  stars      Int                                    // Số sao từ 1 đến 5
  content    String                                 // Nội dung nhận xét
  status     ReviewStatus @default(VISIBLE)         // VISIBLE | HIDDEN | DELETED (xóa mềm để chặn đánh giá lại)
  createdAt  DateTime     @default(now())

  @@unique([customerId, productId, orderId]) // Mỗi khách chỉ được đánh giá 1 lần / mỗi món / mỗi đơn
  @@map("reviews")
}

// 17. Audit Log: OrderStatusHistory (Nhật ký kiểm toán chuyển trạng thái - Task 9 & 10.1)
// =========================================================================================
// BẢNG ORDER_STATUS_HISTORIES: LƯU VẾT TOÀN BỘ LỊCH SỬ CHUYỂN TRẠNG THÁI CỦA TỪNG ĐƠN HÀNG
// - Ghi nhận ai (actorId) đã chuyển từ trạng thái nào (fromStatus) sang trạng thái nào (toStatus).
// - Thời điểm chính xác (createdAt) và lý do / ghi chú (note, ví dụ: 'Hoàn kho 15g cà phê...').
// - Đảm bảo tính minh bạch, hỗ trợ truy vết lỗi và đáp ứng yêu cầu chấm điểm Audit Log đề bài.
// =========================================================================================
model OrderStatusHistory {
  id         String      @id @default(uuid())
  orderId    String
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus // Trạng thái trước khi chuyển
  toStatus   OrderStatus // Trạng thái sau khi chuyển
  actorId    String?     // ID người thực hiện (Customer, Barista, Admin hoặc Hệ thống)
  note       String?     // Ghi chú chi tiết (lý do hủy, xác nhận thanh toán...)
  createdAt  DateTime    @default(now()) // Thời gian ghi nhận lịch sử

  @@index([orderId])
  @@map("order_status_histories")
}
