          "name": "3.5 [Khách 2 - Tranh Mua Thất Bại] Bị CHẶN ĐỨNG với HTTP 409 Conflict (Chống âm kho)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Hệ thống CHẶN ĐỨNG Khách 2 với HTTP 409 Conflict (Không đủ tồn kho)', () => {",
                  "    pm.response.to.have.status(409);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.message).to.include('không đủ tồn kho');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Idempotency-Key", "value": "LAST_CUP_BUYER_2_{{$guid}}" },
              { "key": "Content-Type", "value": "application/json" }
