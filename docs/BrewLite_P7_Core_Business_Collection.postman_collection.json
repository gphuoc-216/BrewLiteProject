    {
      "name": "1. Task 9 - Order State Machine",
      "item": [
        {
          "name": "1.1 [Happy Path] Tạo Đơn Hàng mới (PENDING)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "const orderId = res.id || res.data?.id;",
                  "pm.collectionVariables.set('activeOrderId', orderId);",
                  "pm.test('Đơn hàng khởi tạo thành công ở PENDING', () => {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(res.status || res.data?.status).to.eql('PENDING');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"variantId\": \"{{testVariantId}}\",\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "1.2 [Happy Path] Thanh toán đơn (PENDING -> PAID)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Đơn hàng thanh toán thành công và chuyển sang PAID', () => {",
                  "    pm.expect([200, 201]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Idempotency-Key", "value": "BL_IDEMP_{{$guid}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{activeOrderId}}\",\n  \"method\": \"WALLET\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments",
              "host": ["{{baseUrl}}"],
              "path": ["payments"]
            }
          }
        },
        {
          "name": "1.3 [Happy Path] Barista Nhận Đơn (PAID -> PREPARING)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('Barista nhận đơn thành công, chuyển sang PREPARING', () => {",
                  "    pm.expect([200, 201]).to.include(pm.response.code);",
                  "    pm.expect(res.status || res.data?.status).to.eql('PREPARING');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{staffToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/staff/orders/{{activeOrderId}}/accept",
              "host": ["{{baseUrl}}"],
              "path": ["staff", "orders", "{{activeOrderId}}", "accept"]
            }
          }
        },
        {
          "name": "1.4 [Happy Path] Barista Pha Xong (PREPARING -> READY)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('Pha chế xong, chuyển sang READY', () => {",
                  "    pm.expect([200, 201]).to.include(pm.response.code);",
                  "    pm.expect(res.status || res.data?.status).to.eql('READY');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{staffToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/staff/orders/{{activeOrderId}}/ready",
              "host": ["{{baseUrl}}"],
              "path": ["staff", "orders", "{{activeOrderId}}", "ready"]
            }
          }
        },
        {
          "name": "1.5 [Happy Path] Giao Nước Xong (READY -> COMPLETED)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('Đã hoàn tất bàn giao cho khách (COMPLETED)', () => {",
                  "    pm.expect([200, 201]).to.include(pm.response.code);",
                  "    pm.expect(res.status || res.data?.status).to.eql('COMPLETED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{staffToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/staff/orders/{{activeOrderId}}/complete",
              "host": ["{{baseUrl}}"],
              "path": ["staff", "orders", "{{activeOrderId}}", "complete"]
            }
          }
        },
        {
          "name": "1.6 [Kịch bản LỖI] Tạo Đơn PENDING mới để test nhảy cóc",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.collectionVariables.set('jumpOrderId', res.id || res.data?.id);",
                  "pm.test('Tạo đơn hàng chờ PENDING mới thành công', () => {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"variantId\": \"{{testVariantId}}\",\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "1.7 [Kịch bản LỖI] Cố tình nhảy cóc từ PENDING sang COMPLETED (Bắt buộc HTTP 409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Hệ thống CHẶN ĐỨNG thành công với HTTP 409 Conflict', () => {",
                  "    pm.response.to.have.status(409);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.message).to.include('Không thể chuyển từ');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{staffToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/staff/orders/{{jumpOrderId}}/complete",
              "host": ["{{baseUrl}}"],
              "path": ["staff", "orders", "{{jumpOrderId}}", "complete"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Task 8 - Idempotent Payment",
      "item": [
        {
          "name": "2.1 Chuẩn bị đơn hàng để test Double-click",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const newKey = 'IDEMP_RUN_' + Date.now() + '_' + Math.random().toString(36).substring(2, 7);",
                  "pm.collectionVariables.set('fixedIdempotencyKey', newKey);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.collectionVariables.set('idempOrderId', res.id || res.data?.id);",
                  "pm.test('Tạo đơn cho Idempotency test thành công', () => {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"variantId\": \"{{testVariantId}}\",\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "2.2 Gửi Request Thanh Toán Lần 1 (Tạo mới - HTTP 201 / replayed: false)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "const payload = res.data || res;",
                  "pm.test('Lần 1: Thanh toán thành công mới (HTTP 201, replayed: false)', () => {",
                  "    pm.expect([200, 201]).to.include(pm.response.code);",
                  "    pm.expect(payload.replayed === false || payload.cached === false).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Idempotency-Key", "value": "{{fixedIdempotencyKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{idempOrderId}}\",\n  \"method\": \"WALLET\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments",
              "host": ["{{baseUrl}}"],
              "path": ["payments"]
            }
          }
        },
        {
          "name": "2.3 Gửi Lại Cùng Idempotency-Key (Click đúp - HTTP 200 / replayed: true)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "const payload = res.data || res;",
                  "pm.test('Lần 2: Hệ thống phát hiện Replay, trả kết quả cũ (HTTP 200, replayed: true)', () => {",
                  "    pm.expect([200, 201]).to.include(pm.response.code);",
                  "    pm.expect(payload.replayed === true || payload.cached === true).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Idempotency-Key", "value": "{{fixedIdempotencyKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{idempOrderId}}\",\n  \"method\": \"WALLET\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments",
              "host": ["{{baseUrl}}"],
              "path": ["payments"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Task 10.3 - Optimistic Locking (Chống âm kho)",
      "item": [
