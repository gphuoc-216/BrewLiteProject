{
  "info": {
    "name": "BrewLite - Performance & N-User Load Test (Full 10 Tasks)",
    "description": "Collection tách riêng chuyên dùng chạy Performance / Load Test cho N Virtual Users độc lập qua toàn bộ 10 Task (Register UUID -> Login -> Menu -> Detail -> Voucher -> Order -> Pay -> Replay -> Barista -> Review).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3001/api"
    }
  ],
  "item": [
    {
      "name": "7.1 [Task 7 - Auth] Đăng ký tài khoản ngẫu nhiên (UUID)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const uid = pm.variables.replaceIn('{{$guid}}').replace(/-/g, '').slice(0, 12);",
              "pm.variables.set('vuUsername', 'vu_' + uid);",
              "pm.variables.set('vuEmail', 'vu_' + uid + '@example.com');",
              "pm.variables.set('vuPayKey', 'PAY_' + uid);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('7.1 Đăng ký user mới (HTTP 201)', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{vuUsername}}\",\n  \"password\": \"123456\",\n  \"email\": \"{{vuEmail}}\",\n  \"fullName\": \"Load Test User\",\n  \"phone\": \"0901234567\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        }
      }
    },
    {
      "name": "7.2 [Task 7 - Auth] Đăng nhập đúng tài khoản vừa tạo",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('7.2 Đăng nhập user mới (HTTP 200)', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
              "const res = pm.response.json();",
              "pm.variables.set('vuToken', res.accessToken || (res.data && res.data.accessToken) || '');"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{vuUsername}}\",\n  \"password\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "7.3 [Task 2 & 3 - Menu] Lấy danh sách sản phẩm (NFR-01)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('7.3 Lấy Menu thành công (HTTP 200)', () => pm.response.to.have.status(200));",
              "const res = pm.response.json();",
              "const items = res.items || (res.data && res.data.items) || [];",
              "if (items.length > 0) pm.variables.set('vuProductId', items[0].id);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/products?page=1&limit=8",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "8"
            }
          ]
        }
      }
    },
    {
      "name": "7.4 [Task 4 - Chi tiết] Xem chi tiết sản phẩm (NFR-01)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('7.4 Xem chi tiết món (HTTP 200)', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/products/{{vuProductId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products",
            "{{vuProductId}}"
          ]
        }
      }
    },
    {
      "name": "7.5 [Task 5 & 10.4 - Voucher] Validate mã BREW10",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('7.5 Kiểm tra Voucher hợp lệ (HTTP 200/201)', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{vuToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"BREW10\",\n  \"orderSubtotal\": 49000\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/promotions/validate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "promotions",
            "validate"
          ]
        }
      }
    },
    {
      "name": "7.6 [Task 6 - Đặt hàng] Tạo đơn hàng riêng (PENDING)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('7.6 Tạo đơn PENDING (HTTP 201)', () => pm.response.to.have.status(201));",
              "const res = pm.response.json();",
              "pm.variables.set('vuOrderId', res.id || (res.data && res.data.id) || '');"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{vuToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"variantId\": \"1fb2edac-927b-4595-9d6c-8f2a3213b1d0\",\n      \"quantity\": 1\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders"
          ]
        }
      }
    },
    {
      "name": "7.7 [Task 8 & 10.3 - Thanh toán] Thanh toán lần 1 (PAID)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('7.7 Thanh toán thành công (HTTP 201)', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{vuToken}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{vuPayKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orderId\": \"{{vuOrderId}}\",\n  \"method\": \"WALLET\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/payments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "payments"
          ]
        }
      }
    },
    {
      "name": "7.8 [Task 10.2 - Idempotency] Gửi lại cùng key (Replay 200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('7.8 Idempotent Replay (HTTP 200 & replayed: true)', () => {",
              "    pm.response.to.have.status(200);",
              "    const res = pm.response.json();",
              "    const d = res.data || res;",
              "    pm.expect(d.replayed).to.eql(true);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{vuToken}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{vuPayKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orderId\": \"{{vuOrderId}}\",\n  \"method\": \"WALLET\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/payments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "payments"
          ]
        }
      }
    },
    {
      "name": "7.9 [Task 9 & 10.1 - Barista] Nhận đơn (PAID -> PREPARING)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.variables.get('vuStaffToken')) {",
              "    const baseUrl = pm.collectionVariables.get('baseUrl') || pm.environment.get('baseUrl');",
              "    pm.sendRequest({",
              "        url: baseUrl + '/auth/login',",
              "        method: 'POST',",
              "        header: { 'Content-Type': 'application/json' },",
              "        body: { mode: 'raw', raw: JSON.stringify({ username: 'barista1', password: '123456' }) }",
              "    }, (err, res) => {",
              "        if (!err && res) {",
              "            const j = res.json();",
              "            pm.variables.set('vuStaffToken', j.accessToken || (j.data && j.data.accessToken) || '');",
              "        }",
              "    });",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('7.9 Barista nhận đơn PREPARING', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{vuStaffToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/staff/orders/{{vuOrderId}}/accept",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "staff",
            "orders",
            "{{vuOrderId}}",
            "accept"
          ]
        }
      }
    },
    {
      "name": "7.10 [Task 9 & 10.1 - Barista] Pha xong (PREPARING -> READY)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('7.10 Barista pha xong READY', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{vuStaffToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/staff/orders/{{vuOrderId}}/ready",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "staff",
            "orders",
            "{{vuOrderId}}",
            "ready"
          ]
        }
      }
    },
    {
      "name": "7.11 [Task 9 & 10.1 - Barista] Giao khách (READY -> COMPLETED)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('7.11 Giao khách COMPLETED', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{vuStaffToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/staff/orders/{{vuOrderId}}/complete",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "staff",
            "orders",
            "{{vuOrderId}}",
            "complete"
          ]
        }
      }
    },
    {
      "name": "7.12 [Task 4 & 9 - Review] Gửi đánh giá món sau khi COMPLETED",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('7.12 Gửi đánh giá thành công (HTTP 201)', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{vuToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": \"{{vuProductId}}\",\n  \"stars\": 5,\n  \"content\": \"Đồ uống rất ngon, giao nhanh!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/reviews",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "reviews"
          ]
        }
      }
    }
  ]
}