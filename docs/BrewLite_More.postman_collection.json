            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 49000,\n  \"method\": \"CARD\",\n  \"simulateError\": \"FAIL\"\n}" },
            "url": "{{baseUrl}}/mock-gateway/charge"
          }
        },
        {
          "name": "2.3 MBBank Sync Webhook (POST /payments/mbbank-sync)",
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('MBBank sync OK (200/201)', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"], "type": "text/javascript" } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"orderCode\": \"{{mbOrderCode}}\",\n  \"amount\": 49000,\n  \"content\": \"BREWLITE {{mbOrderCode}}\",\n  \"sender\": \"0589822346\",\n  \"senderName\": \"TEST USER\"\n}" },
            "url": "{{baseUrl}}/payments/mbbank-sync"
          }
        },
        {
          "name": "2.4 MBBank Check Polling (GET /payments/mbbank-check/:orderCode)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('MBBank check trả paid: true', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const r = pm.response.json();",
                  "  const d = r.data || r;",
                  "  pm.expect(d.paid).to.eql(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/payments/mbbank-check/{{mbOrderCode}}?expectedAmount=49000" }
        },
        {
          "name": "2.5 MBBank Invalidate QR (POST /payments/mbbank-invalidate/:orderCode)",
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('Invalidate QR OK', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"], "type": "text/javascript" } }
          ],
          "request": { "method": "POST", "url": "{{baseUrl}}/payments/mbbank-invalidate/{{mbOrderCode}}" }
        }
      ]
