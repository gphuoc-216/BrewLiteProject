      "name": "0. Khởi tạo Token (Admin & Customer)",
      "item": [
        {
          "name": "0.1 Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Admin login OK', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const r = pm.response.json();",
                  "const t = r.accessToken || r.data?.accessToken;",
                  "if (t) pm.collectionVariables.set('adminToken', t);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"123456\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "0.2 Login Customer1",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Customer1 login OK', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const r = pm.response.json();",
                  "const t = r.accessToken || r.data?.accessToken;",
                  "if (t) pm.collectionVariables.set('customerToken', t);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"customer1\",\n  \"password\": \"123456\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "0.3 Lấy Product & Ingredient mẫu",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Lấy danh sách sản phẩm OK', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "const items = r.items || r.data?.items || r.data || [];",
                  "if (items.length > 0) pm.collectionVariables.set('sampleProductId', items[0].id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/products" }
