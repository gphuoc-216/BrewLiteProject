        <mxCell id="m_res_order_created" value="8. HTTP 201 Created: { success: true, data: order }" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#2563eb;" edge="1" parent="1">
