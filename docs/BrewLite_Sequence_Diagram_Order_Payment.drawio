        <mxCell id="m_show_pay_screen" value="9. Hiển thị màn hình xác nhận thanh toán (Tổng tiền sau giảm)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#2563eb;" edge="1" parent="1">
