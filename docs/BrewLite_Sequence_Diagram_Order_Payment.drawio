        <mxCell id="m_ret_created_order" value="7. Commit Transaction &amp; Trả về bản ghi Order" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#16a34a;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
