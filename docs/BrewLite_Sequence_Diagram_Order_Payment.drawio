        <!-- Message: Query DB for variants -->
        <mxCell id="m_query_variants" value="4. findMany(ProductVariant), findUnique(Promotion)&#xa;Kiểm tra giá, điều kiện voucher &amp; tính tổng tiền" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#475569;" edge="1" parent="1">
