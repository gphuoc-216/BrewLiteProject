        <!-- Message: Next.js call POST /orders -->
        <mxCell id="m_post_orders" value="2. POST /api/orders&#xa;[Header: Authorization: Bearer &lt;JWT&gt;]&#xa;Body: { items, promotionCode }" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#2563eb;" edge="1" parent="1">
