              <mxPoint x="395" y="650" />
              <mxPoint x="395" y="690" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Message: POST /payments with Header -->
        <mxCell id="m_post_pay" value="12. POST /api/payments&#xa;[Header: Authorization: Bearer &lt;JWT&gt;]&#xa;[Header: Idempotency-Key: &lt;UUIDv4&gt;]&#xa;Body: { orderId, method: 'WALLET' }" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#d97706;fontStyle=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="345" y="730" as="sourcePoint" />
            <mxPoint x="610" y="730" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Check JWT -->
        <mxCell id="m_check_jwt_2" value="13. JwtAuthGuard: Xác thực Token JWT&#xa;&amp; giải nén user profile" style="html=1;align=left;spacingLeft=5;verticalAlign=middle;rounded=0;edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#64748b;fontColor=#334155;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
