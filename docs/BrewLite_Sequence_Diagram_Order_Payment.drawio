            <mxPoint x="120" y="625" as="sourcePoint" />
            <mxPoint x="345" y="625" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Self message: UI generates Idempotency-Key -->
        <mxCell id="m_gen_idemp_key" value="11. Sinh mã Idempotency-Key duy nhất&#xa;UUIDv4 (ví dụ: '550e8400-e29b-41d4...')" style="html=1;align=left;spacingLeft=5;verticalAlign=middle;rounded=0;edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#3b82f6;fontColor=#1e40af;" edge="1" parent="1">
