        <!-- Message: DB returns product info -->
        <mxCell id="m_ret_variants" value="5. Trả về thông tin biến thể &amp; mức giảm giá" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#475569;" edge="1" parent="1">
