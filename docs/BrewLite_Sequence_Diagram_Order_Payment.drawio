            <mxPoint x="610" y="805" as="targetPoint" />
            <Array as="points">
              <mxPoint x="660" y="765" />
              <mxPoint x="660" y="805" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Call PaymentService -->
        <mxCell id="m_call_service" value="14. processPayment(dto, idempotencyKey, user)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#d97706;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="610" y="830" as="sourcePoint" />
            <mxPoint x="910" y="830" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Query Payment by IdempotencyKey -->
        <mxCell id="m_query_idemp" value="15. prisma.payment.findUnique({ where: { idempotencyKey } })" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#d97706;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="910" y="865" as="sourcePoint" />
            <mxPoint x="1215" y="865" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ==================== KHUNG ALT: KIỂM TRA IDEMPOTENT ==================== -->
        <mxCell id="alt_box_idemp" value="alt: Kiểm tra Khóa chống trùng lặp (Idempotent Check)" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d97706;fontColor=#b45309;fontStyle=1;fontSize=11;width=310;height=25;" vertex="1" parent="1">
          <mxGeometry x="270" y="905" width="980" height="235" as="geometry" />
        </mxCell>

        <!-- Case 1: Replayed -->
        <mxCell id="txt_case_replay" value="[Trường hợp 1: Key ĐÃ TỒN TẠI do khách bấm đúp - Idempotent Replay]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#b45309;fontStyle=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="280" y="930" width="450" height="20" as="geometry" />
        </mxCell>

        <mxCell id="m_db_ret_existing" value="16a. Trả về Payment đã hoàn thành trước đó" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#d97706;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1215" y="960" as="sourcePoint" />
            <mxPoint x="910" y="960" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="m_ret_cached" value="17a. Trả kết quả cũ: { cached: true, replayed: true, payment, order }&#xa;[KHÔNG gọi trừ tiền, KHÔNG trừ kho lần 2]" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#d97706;fontStyle=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="910" y="1000" as="sourcePoint" />
            <mxPoint x="610" y="1000" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="m_res_replay_200" value="18a. HTTP 200 OK (Giao dịch đã xử lý trước đó)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#d97706;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="610" y="1035" as="sourcePoint" />
            <mxPoint x="345" y="1035" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Divider line in Alt -->
        <mxCell id="alt_line" value="" style="line;strokeWidth=1;dashed=1;labelPosition=top;verticalLabelPosition=bottom;align=left;verticalAlign=top;strokeColor=#d97706;" vertex="1" parent="1">
          <mxGeometry x="270" y="1065" width="980" height="10" as="geometry" />
        </mxCell>

        <!-- Case 2: New Key -->
        <mxCell id="txt_case_new" value="[Trường hợp 2: Key CHƯA TỒN TẠI (Thanh toán giao dịch mới)]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#15803d;fontStyle=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="280" y="1075" width="400" height="20" as="geometry" />
        </mxCell>

        <mxCell id="m_db_ret_null" value="16b. Trả về null (Chưa có giao dịch nào với Key này)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#15803d;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1215" y="1110" as="sourcePoint" />
            <mxPoint x="910" y="1110" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ==================== GIAI ĐOẠN 3: TRANSACTION VÀ OPTIMISTIC LOCKING ==================== -->
        <mxCell id="divider_3" value="PHẦN 3: DATABASE TRANSACTION ACID (OPTIMISTIC LOCKING, TRỪ TIỀN &amp; TÍCH ĐIỂM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;fontColor=#14532d;fontStyle=1;fontSize=11;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="60" y="1165" width="1230" height="25" as="geometry" />
        </mxCell>

        <!-- Check State Machine -->
        <mxCell id="m_check_sm" value="19. assertTransition(order.status, 'PAID'):&#xa;Kiểm tra máy trạng thái (PENDING/PAYMENT_FAILED -&gt; PAID)" style="html=1;align=left;spacingLeft=5;verticalAlign=middle;rounded=0;edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#f59e0b;fontColor=#b45309;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="910" y="1205" as="sourcePoint" />
            <mxPoint x="910" y="1245" as="targetPoint" />
            <Array as="points">
              <mxPoint x="960" y="1205" />
              <mxPoint x="960" y="1245" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Begin Transaction -->
        <mxCell id="m_begin_tx" value="20. Bắt đầu Transaction ACID: prisma.$transaction(async tx =&gt; ...)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#16a34a;fontStyle=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="910" y="1275" as="sourcePoint" />
            <mxPoint x="1215" y="1275" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Loop Optimistic lock -->
        <mxCell id="loop_stock" value="loop: Khấu trừ tồn kho nguyên liệu (Optimistic Locking &amp; Retry)" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16a34a;fontColor=#15803d;fontStyle=1;fontSize=11;width=350;height=25;" vertex="1" parent="1">
          <mxGeometry x="840" y="1315" width="410" height="150" as="geometry" />
        </mxCell>

        <mxCell id="m_find_ing" value="21a. tx.ingredient.findUnique({ where: { id } })" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#16a34a;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="910" y="1355" as="sourcePoint" />
            <mxPoint x="1215" y="1355" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="m_update_ing" value="21b. tx.ingredient.updateMany({&#xa;  where: { id, version: currVersion, stockQuantity: { gte: required } },&#xa;  data: { stockQuantity: { decrement: required }, version: { increment: 1 } }&#xa;}) [Chống bán âm khi nhiều khách mua cùng lúc]" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#16a34a;fontStyle=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="910" y="1415" as="sourcePoint" />
            <mxPoint x="1215" y="1415" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Call MockGateway -->
        <mxCell id="m_call_mock" value="22. mockGateway.processCharge({ amount, method: 'WALLET' })" style="html=1;align=left;spacingLeft=5;verticalAlign=middle;rounded=0;edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#f59e0b;fontColor=#b45309;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="910" y="1495" as="sourcePoint" />
            <mxPoint x="910" y="1535" as="targetPoint" />
            <Array as="points">
              <mxPoint x="960" y="1495" />
              <mxPoint x="960" y="1535" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Save Payment & Update Order -->
        <mxCell id="m_save_pay" value="23. tx.payment.create({ idempotencyKey, status: SUCCESS, amount })&#xa;&amp; tx.order.update({ status: PAID })" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#16a34a;fontStyle=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="910" y="1575" as="sourcePoint" />
            <mxPoint x="1215" y="1575" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Loyalty Points & Audit Log -->
        <mxCell id="m_loyalty_log" value="24. tx.customer.update({ loyaltyPoints: +earnedPoints })&#xa;&amp; tx.orderStatusHistory.create({ PENDING -&gt; PAID, note: '...' })" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#16a34a;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="910" y="1635" as="sourcePoint" />
            <mxPoint x="1215" y="1635" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Transaction commit -->
        <mxCell id="m_commit_tx" value="25. Commit Transaction thành công" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#16a34a;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1215" y="1685" as="sourcePoint" />
            <mxPoint x="910" y="1685" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Return to Controller -->
        <mxCell id="m_service_ret" value="26. Trả về: { success: true, cached: false, payment, order, earnedPoints }" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#16a34a;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="910" y="1725" as="sourcePoint" />
            <mxPoint x="610" y="1725" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Controller returns HTTP 201 Created -->
        <mxCell id="m_controller_res" value="27. HTTP 201 Created: { success: true, message: 'Thanh toán thành công', data: ... }" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#2563eb;fontStyle=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="610" y="1765" as="sourcePoint" />
            <mxPoint x="345" y="1765" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- UI displays success & Order Code -->
        <mxCell id="m_ui_success" value="28. Hiển thị: 'Thanh toán thành công! Mã đơn: #ORD-xxxx'&#xa;&amp; Chuyển sang màn hình theo dõi đơn thời gian thực" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#2563eb;fontStyle=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="345" y="1810" as="sourcePoint" />
            <mxPoint x="120" y="1810" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Note on diagram -->
        <mxCell id="note_box" value="GHI CHÚ KỸ THUẬT (KIỂM TRA ĐỒ ÁN):&#xa;1. Check JWT: JwtAuthGuard chặn ngay lập tức nếu thiếu token hoặc token hết hạn (401 Unauthorized).&#xa;2. Chống click đúp: Khách click 2 lần liên tiếp -&gt; Cùng Idempotency-Key -&gt; Lần 2 nhận HTTP 200 Replay, không bao giờ bị trừ tiền 2 lần.&#xa;3. Chống âm kho: Transaction kết hợp Optimistic Locking qua cột 'version' đảm bảo nguyên tử (ACID)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fef08a;strokeColor=#ca8a04;fontColor=#854d0e;fontSize=11;size=15;" vertex="1" parent="1">
          <mxGeometry x="60" y="1870" width="1230" height="90" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>