        <!-- ==================== GIAI ĐOẠN 2: THANH TOÁN & IDEMPOTENCY ==================== -->
        <mxCell id="divider_2" value="PHẦN 2: XÁC THỰC THANH TOÁN &amp; KIỂM TRA IDEMPOTENCY (CHỐNG CLICK ĐÚP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;fontColor=#78350f;fontStyle=1;fontSize=11;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="60" y="575" width="1230" height="25" as="geometry" />
        </mxCell>

        <!-- Message: Customer click pay -->
        <mxCell id="m_click_pay" value="10. Chọn phương thức &amp; Nhấn 'Thanh toán ngay' (Hoặc lỡ tay click đúp 2 lần)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#d97706;" edge="1" parent="1">
