        <!-- Message: Transaction create order PENDING -->
        <mxCell id="m_tx_create_order" value="6. prisma.$transaction:&#xa;• tx.order.create({ status: PENDING, items: [...] })&#xa;• tx.orderStatusHistory.create({ status: PENDING, note: 'Khởi tạo...' })" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#16a34a;fontColor=#15803d;fontStyle=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
