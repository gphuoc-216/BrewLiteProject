ndArrow=block;endFill=1;endSize=8;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#000000;strokeWidth=2.5;fontSize=18;dashed=1;dashPattern=2.5 1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1272" y="1488" as="sourcePoint" /><mxPoint x="817" y="1488" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c59" value="&lt;b&gt;15&lt;/b&gt; HTTP 200 OK:&lt;br&gt;{ success: true, statusCode: 200, cached: true }" style="html=1;endArrow=block;endFill=1;endSize=8;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#000000;strokeWidth=2.5;fontSize=18;dashed=1;dashPattern=2.5 1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="807" y="1548" as="sourcePoint" /><mxPoint x="481" y="1548" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c60" value="&lt;b&gt;16&lt;/b&gt; Hiển thị kết quả an toàn&lt;br&gt;(Không trừ tiền 2 lần)" style="html=1;endArrow=block;endFill=1;endSize=8;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#000000;strokeWidth=2.5;fontSize=18;dashed=1;dashPattern=2.5 1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="471" y="1610" as="sourcePoint" /><mxPoint x="98" y="1610" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c61" value="&lt;b&gt;17&lt;/b&gt; Bắt đầu Transaction ACID" style="html=1;endArrow=block;endFill=1;endSize=8;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#000000;strokeWidth=2.5;fontSize=18;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1283" y="1848" as="sourcePoint" /><mxPoint x="1570" y="1848" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c62" value="&lt;b&gt;18&lt;/b&gt; ingredient.updateMany({&lt;br&gt;stockQuantity: -qty,&lt;br&gt;version: +1&lt;br&gt;})" style="html=1;endArrow=block;endFill=1;endSize=8;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#000000;strokeWidth=2.5;fontSize=18;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1283" y="1980" as="sourcePoint" /><mxPoint x="1570" y="1980" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c63" value="&lt;b&gt;19&lt;/b&gt; • payment.create(SUCCESS)&lt;br&gt;• order.update(PAID)&lt;br&gt;• promotion.update(+usedCount)&lt;br&gt;• customer.update(+points)&lt;br&gt;• orderStatusHistory.create()" style="html=1;endArrow=block;endFill=1;endSize=8;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#000000;strokeWidth=2.5;fontSize=18;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1283" y="2198" as="sourcePoint" /><mxPoint x="1570" y="2198" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c64" value="&lt;b&gt;20&lt;/b&gt; Commit thành công" style="html=1;endArrow=block;endFill=1;endSize=8;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#000000;strokeWidth=2.5;fontSize=18;dashed=1;dashPattern=2.5 1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1570" y="2242" as="sourcePoint" /><mxPoint x="1283" y="2242" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c65" value="&lt;b&gt;21&lt;/b&gt; { success: true, cached: false,&lt;br&gt;payment, order, earnedPoints }" style="html=1;endArrow=block;endFill=1;endSize=8;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#000000;strokeWidth=2.5;fontSize=18;dashed=1;dashPattern=2.5 1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1272" y="2300" as="sourcePoint" /><mxPoint x="817" y="2300" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c66" value="&lt;b&gt;22&lt;/b&gt; HTTP 201 Created:&lt;br&gt;{ success: true, statusCode: 201, data: ... }" style="html=1;endArrow=block;endFill=1;endSize=8;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#000000;strokeWidth=2.5;fontSize=18;dashed=1;dashPattern=2.5 1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="807" y="2360" as="sourcePoint" /><mxPoint x="481" y="2360" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c67" value="&lt;b&gt;23&lt;/b&gt; Hiển thị &quot;Thanh toán thành công&quot;&lt;br&gt;&amp;amp; chuyển trang đơn hàng /orders/:id" style="html=1;endArrow=block;endFill=1;endSize=8;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#000000;strokeWidth=2.5;fontSize=18;dashed=1;dashPattern=2.5 1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="471" y="2420" as="sourcePoint" /><mxPoint x="98" y="2420" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c68" value="&lt;b&gt;1. Check JWT, Roles &amp;amp; Validate DTO&lt;/b&gt;&lt;br&gt;JwtAuthGuard + Roles(CUSTOMER)&lt;br&gt;lấy customerId = user.customerId || user.profileId&lt;br&gt;&amp;amp; ValidationPipe kiểm tra CreateOrderDto" style="shape=note;size=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingTop=-3;fillColor=#fff9e6;strokeColor=#666666;fontSize=18;" vertex="1" parent="1"><mxGeometry x="608" y="328" width="368" height="86" as="geometry" /></mxCell><mxCell id="c69" value="&lt;b&gt;2. Sinh Idempotency-Key&lt;/b&gt;&lt;br&gt;Tạo UUIDv4 gắn vào Header" style="shape=note;size=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingTop=-3;fillColor=#fff9e6;strokeColor=#666666;fontSize=18;" vertex="1" parent="1"><mxGeometry x="335" y="898" width="280" height="50" as="geometry" /></mxCell><mxCell id="c70" value="&lt;b&gt;3. Check JWT, Roles &amp;amp; Validate DTO&lt;/b&gt;&lt;br&gt;JwtAuthGuard + Roles(CUSTOMER)&lt;br&gt;&amp;amp; ValidationPipe (ProcessPaymentDto)" style="shape=note;size=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingTop=-3;fillColor=#fff9e6;strokeColor=#666666;fontSize=18;" vertex="1" parent="1"><mxGeometry x="642" y="1080" width="340" height="70" as="geometry" /></mxCell><mxCell id="c71" value="&lt;b&gt;4a. Xử lý Idempotency Replay &amp;amp; Chống tráo Payload&lt;/b&gt;&lt;br&gt;Check chủ đơn (403) &amp;amp; orderId/method (lệch → HTTP 422);&lt;br&gt;trùng khớp thì trả ngay kết quả cũ (KHÔNG trừ tiền/kho lần 2)" style="shape=note;size=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingTop=-3;fillColor=#fff2cc;strokeColor=#666666;fontSize=18;" vertex="1" parent="1"><mxGeometry x="748" y="1374" width="550" height="72" as="geometry" /></mxCell><mxCell id="c72" value="&lt;b&gt;4b. Quyền sở hữu, Paid Guard &amp;amp; State Machine&lt;/b&gt;&lt;br&gt;Check chủ đơn (403); chặn nếu PAID (409);&lt;br&gt;assertTransition(PENDING / PAYMENT_FAILED → PAID)" style="shape=note;size=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingTop=-3;fillColor=#fff9e6;strokeColor=#666666;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1065" y="1666" width="425" height="72" as="geometry" /></mxCell><mxCell id="c73" value="&lt;b&gt;5. DB Transaction ACID&lt;/b&gt;&lt;br&gt;prisma.$transaction(...)" style="shape=note;size=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingTop=-3;fillColor=#e6ffec;strokeColor=#666666;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1246" y="1754" width="340" height="52" as="geometry" /></mxCell><mxCell id="c74" value="&lt;b&gt;6. Gọi Cổng thanh toán (sau bước OCC)&lt;/b&gt;&lt;br&gt;mockGateway.processCharge({ amount, method })" style="shape=note;size=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingTop=-3;fillColor=#fff9e6;strokeColor=#666666;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1090" y="2020" width="376" height="54" as="geometry" /></mxCell><mxCell id="c75" style="endArrow=none;html=1;dashed=1;dashPattern=1 2;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="27" y="2436" as="sourcePoint" /><mxPoint x="1764" y="2436" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c76" value="[TH 3: Thanh toán thất bại (Hết kho/OCC 409 hoặc Gateway 400 / 408 Timeout)]" style="text;html=1;align=left;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="36" y="2442" width="760" height="22" as="geometry" /></mxCell><mxCell id="c77" value="&lt;b&gt;24&lt;/b&gt; Rollback TX; nếu Gateway lỗi:&lt;br&gt;order.update(PAYMENT_FAILED)&lt;br&gt;&amp;amp; orderStatusHistory.create()" style="html=1;endArrow=block;endFill=1;endSize=8;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#000000;strokeWidth=2.5;fontSize=18;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1283" y="2524" as="sourcePoint" /><mxPoint x="1570" y="2524" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c81" value="&lt;b&gt;25&lt;/b&gt; Xác nhận Rollback" style="html=1;endArrow=block;endFill=1;endSize=8;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#000000;strokeWidth=2.5;fontSize=18;dashed=1;dashPattern=2.5 1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1570" y="2570" as="sourcePoint" /><mxPoint x="1283" y="2570" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c78" value="&lt;b&gt;26&lt;/b&gt; HTTP 409 Conflict /&lt;br&gt;400 Bad Request / 408 Timeout" style="html=1;endArrow=block;endFill=1;endSize=8;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#000000;strokeWidth=2.5;fontSize=18;dashed=1;dashPattern=2.5 1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1272" y="2632" as="sourcePoint" /><mxPoint x="817" y="2632" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c79" value="&lt;b&gt;27&lt;/b&gt; HTTP 409 Conflict /&lt;br&gt;400 Bad Request / 408 Timeout" style="html=1;endArrow=block;endFill=1;endSize=8;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#000000;strokeWidth=2.5;fontSize=18;dashed=1;dashPattern=2.5 1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="807" y="2690" as="sourcePoint" /><mxPoint x="481" y="2690" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c80" value="&lt;b&gt;28&lt;/b&gt; Hiển thị thông báo lỗi &amp;amp;&lt;br&gt;cho phép thử thanh toán lại / hủy đơn" style="html=1;endArrow=block;endFill=1;endSize=8;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#000000;strokeWidth=2.5;fontSize=18;dashed=1;dashPattern=2.5 1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="471" y="2750" as="sourcePoint" /><mxPoint x="98" y="2750" as="targetPoint" /></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>