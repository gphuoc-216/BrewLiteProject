oyaltyPoints) [nếu dùng]&lt;br&gt;• order.create(PENDING)&lt;br&gt;• orderStatusHistory.create()" style="html=1;endArrow=block;endFill=1;endSize=8;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#000000;strokeWidth=2.5;fontSize=18;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="817" y="632" as="sourcePoint" /><mxPoint x="1570" y="632" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c50" value="&lt;b&gt;6&lt;/b&gt; Commit &amp;amp; trả về Order" style="html=1;endArrow=block;endFill=1;endSize=8;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#000000;strokeWidth=2.5;fontSize=18;dashed=1;dashPattern=2.5 1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1570" y="672" as="sourcePoint" /><mxPoint x="817" y="672" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c51" value="&lt;b&gt;7&lt;/b&gt; HTTP 201 Created:&lt;br&gt;{ success: true, statusCode: 201, data: order }" style="html=1;endArrow=block;endFill=1;endSize=8;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#000000;strokeWidth=2.5;fontSize=18;dashed=1;dashPattern=2.5 1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="807" y="732" as="sourcePoint" /><mxPoint x="481" y="732" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c52" value="&lt;b&gt;8&lt;/b&gt; Hiển thị chọn phương thức thanh toán" style="html=1;endArrow=block;endFill=1;endSize=8;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#000000;strokeWidth=2.5;fontSize=18;dashed=1;dashPattern=2.5 1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="471" y="772" as="sourcePoint" /><mxPoint x="98" y="772" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c53" value="&lt;b&gt;9&lt;/b&gt; Nhấn &quot;Thanh toán ngay&quot;&lt;br&gt;(Hoặc bấm đúp 2 lần)" style="html=1;endArrow=block;endFill=1;endSize=8;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#000000;strokeWidth=2.5;fontSize=18;" edge="1" parent="1"