        <!-- ==================== GIAI ĐOẠN 1: TẠO ĐƠN HÀNG (PENDING) ==================== -->
        <mxCell id="divider_1" value="PHẦN 1: KHỞI TẠO ĐƠN HÀNG (TRẠNG THÁI PENDING)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#94a3b8;fontColor=#1e293b;fontStyle=1;fontSize=11;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="1230" height="25" as="geometry" />
        </mxCell>

        <!-- Message: Customer click Dat hang -->
        <mxCell id="m_click_order" value="1. Chọn món, áp Voucher &amp; Bấm 'Đặt hàng'" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#2563eb;" edge="1" parent="1">
