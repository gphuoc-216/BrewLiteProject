        <mxCell id="lane_backend" value="HỆ THỐNG BACKEND (NESTJS API &amp; POSTGRESQL)" style="swimlane;startSize=40;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#334155;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1">
