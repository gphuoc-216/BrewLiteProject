        <mxCell id="lane_gateway" value="CỔNG THANH TOÁN («SYSTEM» MOCK GATEWAY)" style="swimlane;startSize=40;fillColor=#fffbeb;strokeColor=#f59e0b;fontColor=#b45309;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="840" y="80" width="340" height="2520" as="geometry" />
