          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Check Login [Chưa] -> Login Form -->
        <mxCell id="e_login_no" value="[Chưa đăng nhập]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#d97706;" edge="1" parent="1" source="dec_is_logged_in" target="act_login_form">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="350" y="560" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Login Form -> Auth Verify -->
        <mxCell id="e_form_verify" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="act_login_form" target="act_auth_verify">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Auth Verify -> Merge Login -->
        <mxCell id="e_verify_merge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="act_auth_verify" target="merge_login">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="620" y="720" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Check Login [Đã] -> Merge Login -->
        <mxCell id="e_login_yes" value="[Đã đăng nhập]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#2563eb;" edge="1" parent="1" source="dec_is_logged_in" target="merge_login">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="140" y="600" as="sourcePoint" />
            <Array as="points">
              <mxPoint x="150" y="560" />
              <mxPoint x="150" y="720" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Merge Login -> Submit Order -->
        <mxCell id="e_merge_submit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="merge_login" target="act_submit_order">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Submit Order -> Create Pending -->
        <mxCell id="e_submit_create" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="act_submit_order" target="act_create_pending">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Create Pending -> Click Pay -->
        <mxCell id="e_create_pay" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="act_create_pending" target="act_click_pay">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="620" y="835" />
              <mxPoint x="220" y="835" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Click Pay -> Process Payment -->
        <mxCell id="e_click_process" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="act_click_pay" target="act_process_payment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Process Payment -> Check Stock -->
        <mxCell id="e_proc_stock" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="act_process_payment" target="act_check_stock">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Check Stock -> Decision Stock -->
        <mxCell id="e_stock_dec" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="act_check_stock" target="dec_stock_available">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Decision Stock [Không đủ] -> Stock Conflict -->
        <mxCell id="e_stock_no" value="[Không đủ tồn kho / Hết hàng]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#ef4444;fontStyle=1;" edge="1" parent="1" source="dec_stock_available" target="act_stock_conflict">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="515" y="1055" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Stock Conflict -> Show Out of Stock -->
        <mxCell id="e_conflict_show" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="act_stock_conflict" target="act_show_out_of_stock">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Show Out of Stock -> End Stock -->
        <mxCell id="e_show_end_stock" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="act_show_out_of_stock" target="end_node_stock">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Decision Stock [Đủ] -> Call Gateway -->
        <mxCell id="e_stock_yes" value="[Đủ nguyên liệu]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#16a34a;fontStyle=1;" edge="1" parent="1" source="dec_stock_available" target="act_call_gateway">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Call Gateway -> Gateway Process -->
        <mxCell id="e_call_process" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="act_call_gateway" target="act_gateway_process">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Gateway Process -> Decision Payment Success -->
        <mxCell id="e_gateway_dec" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="act_gateway_process" target="dec_payment_success">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Decision Payment [Thất bại] -> Payment Failed -->
        <mxCell id="e_pay_failed" value="[Thất bại / Lỗi thẻ]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#ef4444;fontStyle=1;" edge="1" parent="1" source="dec_payment_success" target="act_payment_failed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Payment Failed -> Show Pay Failed -->
        <mxCell id="e_failed_show" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="act_payment_failed" target="act_show_pay_failed">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1010" y="1380" />
              <mxPoint x="220" y="1380" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Show Pay Failed -> End Fail -->
        <mxCell id="e_show_end_fail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="act_show_pay_failed" target="end_node_payment_fail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Decision Payment [Thành công] -> TX Success -->
        <mxCell id="e_pay_success" value="[Thanh toán thành công]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#16a34a;fontStyle=1;" edge="1" parent="1" source="dec_payment_success" target="act_tx_success">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="870" y="1230" />
              <mxPoint x="870" y="1510" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- TX Success -> Show Paid Order -->
        <mxCell id="e_tx_show_paid" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="act_tx_success" target="act_show_paid_order">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- TX Success -> Kanban Receive -->
        <mxCell id="e_tx_kanban" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="act_tx_success" target="act_kanban_receive">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Kanban Receive -> Accept Order -->
        <mxCell id="e_kanban_accept" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="act_kanban_receive" target="act_accept_order">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Accept Order -> Make Drinks -->
        <mxCell id="e_accept_make" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="act_accept_order" target="act_make_drinks">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Make Drinks -> Mark Ready -->
        <mxCell id="e_make_ready" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="act_make_drinks" target="act_mark_ready">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Mark Ready -> Notify Customer -->
        <mxCell id="e_ready_notify" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="act_mark_ready" target="act_customer_ready_notify">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Notify Customer -> Show Code -->
        <mxCell id="e_notify_show_code" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="act_customer_ready_notify" target="act_show_code">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Show Code -> Deliver Drinks -->
        <mxCell id="e_code_deliver" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="act_show_code" target="act_deliver_drinks">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Deliver Drinks -> Receive Drink -->
        <mxCell id="e_deliver_receive" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="act_deliver_drinks" target="act_receive_drink">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1360" y="1980" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Receive Drink -> End Success -->
        <mxCell id="e_receive_end" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="act_receive_drink" target="end_node_success">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>