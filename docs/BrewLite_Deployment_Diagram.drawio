        <mxCell id="core" value="&lt;b&gt;8 NestJS Feature Modules &amp;amp; Internal Mock Gateway&lt;/b&gt;&lt;br&gt;• &lt;b&gt;AuthModule&lt;/b&gt; (JWT 15m/7d, Bcrypt) &amp;nbsp;• &lt;b&gt;ProductsModule&lt;/b&gt; (Menu &amp;amp; Recipes)&lt;br&gt;• &lt;b&gt;OrdersModule&lt;/b&gt; (State Machine) &amp;nbsp;&amp;nbsp;&amp;nbsp;• &lt;b&gt;PromotionsModule&lt;/b&gt; • &lt;b&gt;ReviewsModule&lt;/b&gt;&lt;br&gt;• &lt;b&gt;PaymentModule&lt;/b&gt; (Idempotency, OCC, &lt;i&gt;mbbank-sync&lt;/i&gt; &amp;amp; &lt;b&gt;MockGatewayService&lt;/b&gt;)&lt;br&gt;• &lt;b&gt;StaffModule&lt;/b&gt; (Kanban FIFO) &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;• &lt;b&gt;AdminModule&lt;/b&gt; (Kho, NCC, Doanh thu)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" parent="c_backend" vertex="1">
