<?xml version="1.0" ?>
<mxfile host="app.diagrams.net">
  <diagram id="brewlite-deployment" name="Deployment - BrewLite">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="1215" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="edge_proxy" value="&lt;b&gt;Edge CDN &amp;amp; HTTPS Reverse Proxy&lt;/b&gt;&lt;br&gt;«cloud / edge» Cloudflare Tunnel / Reverse Proxy" style="shape=cube;boundedLbl=1;backgroundOutline=1;darkOpacity=0;darkOpacity2=0;size=12;verticalAlign=top;spacingTop=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="20" y="20" width="400" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="edge_artifact" value="&lt;b&gt;TLS 1.3 Termination — Public Port: 443 (HTTPS)&lt;/b&gt;&lt;br&gt;• Forward Web UI &amp;amp; /api/* → &lt;i&gt;brewlite_frontend (:3000)&lt;/i&gt;&lt;br&gt;• Runner: &lt;i&gt;scripts/tunnel.js&lt;/i&gt; (&lt;i&gt;*.trycloudflare.com&lt;/i&gt;)&lt;br&gt;• Security: Không public Port 5432 DB &amp;amp; Port 3001 nội bộ" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" parent="edge_proxy" vertex="1">
          <mxGeometry x="18" y="68" width="352" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="cicd" value="&lt;b&gt;Local Build &amp;amp; Quality Verification&lt;/b&gt;&lt;br&gt;«workstation» Monorepo CLI &amp;amp; Docker Compose Build" style="shape=cube;boundedLbl=1;backgroundOutline=1;darkOpacity=0;darkOpacity2=0;size=12;verticalAlign=top;spacingTop=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="595" y="20" width="1000" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="gh_actions" value="&lt;b&gt;Local Verification &amp;amp; API QA&lt;/b&gt; (&lt;i&gt;Node.js 20 LTS&lt;/i&gt;)&lt;br&gt;• &lt;b&gt;Unit Tests&lt;/b&gt;: &lt;i&gt;npm test&lt;/i&gt; (10 suites, 100 Jest specs) + &lt;i&gt;npm run test:race&lt;/i&gt; (OCC)&lt;br&gt;• &lt;b&gt;API &amp;amp; E2E QA&lt;/b&gt;: Swagger (&lt;i&gt;/api/docs&lt;/i&gt;) &amp;amp; Postman Collection (&lt;i&gt;docs/BrewLite_Full_API_Collection&lt;/i&gt;)&lt;br&gt;• &lt;b&gt;Build&lt;/b&gt;: &lt;i&gt;npm run build:backend&lt;/i&gt; &amp;amp; &lt;i&gt;npm run build:frontend&lt;/i&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" parent="cicd" vertex="1">
          <mxGeometry x="20" y="62" width="550" height="100" as="geometry"/>
        </mxCell>
