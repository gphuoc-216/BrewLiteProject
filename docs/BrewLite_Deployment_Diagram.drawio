<mxfile host="app.diagrams.net" modified="2026-11-01T21:35:00.000Z" agent="BrewLite" version="24.7.5">
  <diagram id="BrewLite-Deployment-Diagram" name="Deployment Diagram - Kiến Trúc Triển Khai">
    <mxGraphModel dx="1800" dy="2400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ==================== BANNER TIÊU ĐỀ ==================== -->
        <mxCell id="title" value="SƠ ĐỒ TRIỂN KHAI HỆ THỐNG THỰC TẾ (PRODUCTION DEPLOYMENT DIAGRAM) - BREWLITE SYSTEM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#1e293b;fontColor=#ffffff;fontStyle=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1720" height="45" as="geometry" />
        </mxCell>

        <!-- ==================== NODE 1: CLIENT TIER (THIẾT BỊ NGƯỜI DÙNG) ==================== -->
        <mxCell id="node_client" value="&lt;&lt;device&gt;&gt;&#xa;&lt;b&gt;User Device (Thiết bị Người dùng)&lt;/b&gt;&#xa;[Laptop / PC / Smartphone]" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=15;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#1e40af;fontStyle=0;fontSize=12;align=center;verticalAlign=top;spacingTop=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="300" height="420" as="geometry" />
        </mxCell>

        <!-- Environment: Web Browser -->
        <mxCell id="env_browser" value="&lt;&lt;executionEnvironment&gt;&gt;&#xa;&lt;b&gt;Web Browser&lt;/b&gt;&#xa;[Chrome, Safari, Edge, Firefox]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#60a5fa;fontColor=#1d4ed8;fontStyle=0;fontSize=11;verticalAlign=top;spacingTop=10;" vertex="1" parent="node_client">
          <mxGeometry x="25" y="60" width="250" height="330" as="geometry" />
        </mxCell>

        <!-- Artifact: Single Page Application / Client Bundle -->
        <mxCell id="art_spa" value="&lt;&lt;artifact&gt;&gt;&#xa;&lt;b&gt;BrewLite Web UI Client&lt;/b&gt;&#xa;• React 18 Components&#xa;• Tailwind CSS &amp; Lucide Icons&#xa;• LocalStorage / Cookie (JWT, Cart)&#xa;• Fetch API / Axios (REST Client)&#xa;• Idempotency Key Generator" style="shape=module;align=left;spacingLeft=15;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=11;" vertex="1" parent="env_browser">
          <mxGeometry x="20" y="65" width="210" height="135" as="geometry" />
        </mxCell>

        <!-- Actor: Customer & Staff -->
        <mxCell id="act_users" value="&lt;b&gt;Người dùng tương tác:&lt;/b&gt;&#xa;👤 Khách hàng (Customer)&#xa;☕ Nhân viên quầy (Barista)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#334155;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="env_browser">
          <mxGeometry x="20" y="220" width="210" height="85" as="geometry" />
        </mxCell>

        <!-- ==================== NODE 2: FRONTEND TIER (VERCEL EDGE NETWORK) ==================== -->
        <mxCell id="node_vercel" value="&lt;&lt;cloud / PaaS&gt;&gt;&#xa;&lt;b&gt;Vercel Edge Platform&lt;/b&gt;&#xa;[Global CDN &amp; Serverless Hosting]&#xa;Domain: https://brewlite.vercel.app" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=15;fillColor=#f0fdf4;strokeColor=#22c55e;fontColor=#15803d;fontStyle=0;fontSize=12;align=center;verticalAlign=top;spacingTop=15;" vertex="1" parent="1">
          <mxGeometry x="420" y="100" width="350" height="420" as="geometry" />
        </mxCell>

        <!-- Environment: Node.js Runtime Vercel -->
        <mxCell id="env_vercel_node" value="&lt;&lt;executionEnvironment&gt;&gt;&#xa;&lt;b&gt;Node.js 18+ Edge Runtime&lt;/b&gt;&#xa;[Next.js App Server]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4ade80;fontColor=#166534;fontStyle=0;fontSize=11;verticalAlign=top;spacingTop=10;" vertex="1" parent="node_vercel">
          <mxGeometry x="25" y="75" width="300" height="315" as="geometry" />
        </mxCell>

        <!-- Artifact: Next.js App Router Build -->
        <mxCell id="art_nextjs" value="&lt;&lt;artifact&gt;&gt;&#xa;&lt;b&gt;brewlite-frontend:latest&lt;/b&gt;&#xa;• Next.js 14 (App Router)&#xa;• Server-Side Rendering (SSR)&#xa;• Static Site Generation (SSG)&#xa;• Edge Middleware (Auth Guard)&#xa;• Next Public API Gateway Proxy" style="shape=module;align=left;spacingLeft=15;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=11;" vertex="1" parent="env_vercel_node">
          <mxGeometry x="25" y="65" width="250" height="135" as="geometry" />
        </mxCell>

        <!-- Config: Env Vars Vercel -->
        <mxCell id="cfg_vercel" value="&lt;b&gt;Environment Variables:&lt;/b&gt;&#xa;• NEXT_PUBLIC_API_URL=https://api.brewlite.vn&#xa;• NODE_ENV=production" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#334155;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="env_vercel_node">
          <mxGeometry x="25" y="220" width="250" height="70" as="geometry" />
        </mxCell>

        <!-- ==================== NODE 3: BACKEND TIER (RENDER / CLOUD VPS DOCKER) ==================== -->
        <mxCell id="node_backend" value="&lt;&lt;cloud / VPS / PaaS&gt;&gt;&#xa;&lt;b&gt;Render.com / Cloud VPS (Ubuntu 22.04 LTS)&lt;/b&gt;&#xa;Domain: https://api.brewlite.vn (Reverse Proxy Nginx / Port 443)" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=15;fillColor=#fff7ed;strokeColor=#f97316;fontColor=#c2410c;fontStyle=0;fontSize=12;align=center;verticalAlign=top;spacingTop=15;" vertex="1" parent="1">
          <mxGeometry x="860" y="100" width="460" height="660" as="geometry" />
        </mxCell>

        <!-- Environment: Docker Engine -->
        <mxCell id="env_docker" value="&lt;&lt;executionEnvironment&gt;&gt;&#xa;&lt;b&gt;Docker Engine 24+&lt;/b&gt; (Bridge Network: brewlite_network)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fb923c;fontColor=#9a3412;fontStyle=0;fontSize=11;verticalAlign=top;spacingTop=10;" vertex="1" parent="node_backend">
          <mxGeometry x="25" y="70" width="410" height="565" as="geometry" />
        </mxCell>

        <!-- Container: brewlite_backend -->
        <mxCell id="ctn_backend" value="&lt;&lt;container&gt;&gt; &lt;b&gt;brewlite_backend&lt;/b&gt; [Port: 3001]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#f97316;fontColor=#7c2d12;fontStyle=1;fontSize=11;verticalAlign=top;spacingTop=10;" vertex="1" parent="env_docker">
          <mxGeometry x="20" y="55" width="370" height="485" as="geometry" />
        </mxCell>

        <!-- Artifact: NestJS Application -->
        <mxCell id="art_nestjs" value="&lt;&lt;artifact&gt;&gt;&#xa;&lt;b&gt;dist/main.js (NestJS 10 Framework)&lt;/b&gt;&#xa;• Node.js 20 Alpine Linux Container&#xa;• Global ValidationPipe &amp; ExceptionFilters&#xa;• JwtAuthGuard &amp; RolesGuard (RBAC)&#xa;• Helmet &amp; CORS Middleware (Allow Vercel)" style="shape=module;align=left;spacingLeft=15;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;fontColor=#991b1b;fontSize=11;" vertex="1" parent="ctn_backend">
          <mxGeometry x="20" y="50" width="330" height="110" as="geometry" />
        </mxCell>

        <!-- Artifact Modules & Engines -->
        <mxCell id="art_modules" value="&lt;&lt;components&gt;&gt;&#xa;&lt;b&gt;Core Business Modules &amp; Engines:&lt;/b&gt;&#xa;• AuthModule (JWT Access &amp; Refresh Tokens)&#xa;• OrdersModule (State Machine: PENDING ➔ PAID ➔ PREPARING...)&#xa;• PaymentModule (Idempotency Engine &amp; Mock Gateway)&#xa;• StaffModule (Kanban Real-time &amp; Order Processing)&#xa;• InventoryEngine (Optimistic Locking Concurrency OCC)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#eab308;fontColor=#854d0e;fontSize=10.5;align=left;spacingLeft=10;" vertex="1" parent="ctn_backend">
          <mxGeometry x="20" y="180" width="330" height="120" as="geometry" />
        </mxCell>

        <!-- Artifact: Prisma ORM Client -->
        <mxCell id="art_prisma" value="&lt;&lt;artifact / ORM&gt;&gt;&#xa;&lt;b&gt;Prisma Client &amp; Query Engine&lt;/b&gt;&#xa;• Connection Pooling (Max 10-20 clients)&#xa;• Interactive Transactions ($transaction)&#xa;• Prepared Statements &amp; SQL Injection Defense&#xa;• Schema Migrations &amp; Seed Engine" style="shape=module;align=left;spacingLeft=15;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;fontColor=#166534;fontSize=11;" vertex="1" parent="ctn_backend">
          <mxGeometry x="20" y="320" width="330" height="95" as="geometry" />
        </mxCell>

        <!-- Config: Backend Env -->
        <mxCell id="cfg_backend" value="&lt;b&gt;Environment Variables:&lt;/b&gt;&#xa;• DATABASE_URL=postgresql://postgres:...@supabase.co:5432/brewlite_db?sslmode=require&#xa;• JWT_SECRET, FRONTEND_URL, PORT=3001" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#334155;fontSize=9.5;align=left;spacingLeft=10;" vertex="1" parent="ctn_backend">
          <mxGeometry x="20" y="430" width="330" height="45" as="geometry" />
        </mxCell>

        <!-- ==================== NODE 4: DATABASE TIER (SUPABASE / CLOUD POSTGRESQL) ==================== -->
        <mxCell id="node_db" value="&lt;&lt;cloud / Managed DB&gt;&gt;&#xa;&lt;b&gt;Supabase / AWS RDS / Neon Postgres&lt;/b&gt;&#xa;[Port: 5432 / 6543 (PgBouncer)]" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=15;fillColor=#f5f3ff;strokeColor=#8b5cf6;fontColor=#5b21b6;fontStyle=0;fontSize=12;align=center;verticalAlign=top;spacingTop=15;" vertex="1" parent="1">
          <mxGeometry x="1400" y="100" width="360" height="660" as="geometry" />
        </mxCell>

        <!-- Environment: PostgreSQL DBMS -->
        <mxCell id="env_postgres" value="&lt;&lt;databaseSystem&gt;&gt;&#xa;&lt;b&gt;PostgreSQL 16 Engine (Alpine Linux)&lt;/b&gt;&#xa;SSL/TLS Encrypted (sslmode=require)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a78bfa;fontColor=#6d28d9;fontStyle=0;fontSize=11;verticalAlign=top;spacingTop=10;" vertex="1" parent="node_db">
          <mxGeometry x="25" y="70" width="310" height="565" as="geometry" />
        </mxCell>

        <!-- Database: brewlite_db -->
        <mxCell id="db_instance" value="&lt;&lt;database&gt;&gt;&#xa;&lt;b&gt;brewlite_db&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#4c1d95;fontStyle=1;fontSize=12;" vertex="1" parent="env_postgres">
          <mxGeometry x="25" y="55" width="260" height="85" as="geometry" />
        </mxCell>

        <!-- Tables & Schemas -->
        <mxCell id="db_tables" value="&lt;&lt;schemas &amp; tables&gt;&gt;&#xa;&lt;b&gt;Core Relations &amp; Constraints:&lt;/b&gt;&#xa;• accounts, customers, staffs&#xa;• products, product_variants&#xa;• orders, order_items&#xa;• payments (idempotencyKey [Unique])&#xa;• promotions, recipes&#xa;• ingredients (version: Int [OCC])&#xa;• order_status_histories (Audit Trail)&#xa;• reviews, suppliers, import_receipts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#c084fc;fontColor=#581c87;fontSize=10.5;align=left;spacingLeft=10;" vertex="1" parent="env_postgres">
          <mxGeometry x="25" y="160" width="260" height="200" as="geometry" />
        </mxCell>

        <!-- Volume & Persistence -->
        <mxCell id="db_storage" value="&lt;&lt;storage&gt;&gt;&#xa;&lt;b&gt;Persistent NVMe SSD Volume&lt;/b&gt;&#xa;• Daily Automated Snapshots&#xa;• WAL (Write-Ahead-Log) Archiving&#xa;• Point-in-time Recovery (PITR)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#334155;fontSize=10.5;" vertex="1" parent="env_postgres">
          <mxGeometry x="25" y="380" width="260" height="155" as="geometry" />
        </mxCell>

        <!-- ==================== NODE 5: EXTERNAL SERVICES (PAYMENT GATEWAY & CLOUD STORAGE) ==================== -->
        <mxCell id="node_external" value="&lt;&lt;thirdPartyCloud&gt;&gt;&#xa;&lt;b&gt;External Services (Dịch vụ bên thứ ba)&lt;/b&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=15;fillColor=#fdf4ff;strokeColor=#d946ef;fontColor=#86198f;fontStyle=0;fontSize=12;align=center;verticalAlign=top;spacingTop=15;" vertex="1" parent="1">
          <mxGeometry x="420" y="580" width="350" height="180" as="geometry" />
        </mxCell>

        <mxCell id="svc_payment" value="&lt;&lt;service&gt;&gt;&#xa;&lt;b&gt;Mock Payment Gateway / VNPay&lt;/b&gt;&#xa;• REST API / Webhooks&#xa;• Phản hồi kết quả thanh toán tức thì" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fae8ff;strokeColor=#c026d3;fontColor=#701a75;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="node_external">
          <mxGeometry x="25" y="65" width="300" height="90" as="geometry" />
        </mxCell>

        <!-- ==================== BANNER GHI CHÚ QUY CHUẨN DEVOPS ==================== -->
        <mxCell id="devops_box" value="&lt;b&gt;CƠ CHẾ KẾT NỐI, BẢO MẬT &amp; ĐIỀU PHỐI MẠNG (DEVOPS &amp; SECURITY PROTOCOLS):&lt;/b&gt;&#xa;1. &lt;b&gt;Client ➔ Vercel:&lt;/b&gt; Giao thức HTTPS (TLS 1.3, Cổng 443). Người dùng tải giao diện Web Next.js 14 App Router qua mạng CDN toàn cầu.&#xa;2. &lt;b&gt;Client ➔ NestJS API:&lt;/b&gt; Giao thức HTTPS RESTful API. Mọi request đều kèm Header `Authorization: Bearer &lt;JWT&gt;` và `X-Idempotency-Key` (Task 10.2).&#xa;3. &lt;b&gt;CORS Protection:&lt;/b&gt; NestJS cấu hình CORS chỉ cho phép Origin tin cậy (`https://brewlite.vercel.app` hoặc `http://localhost:3000`). Chặn hoàn toàn truy cập lậu.&#xa;4. &lt;b&gt;NestJS API ➔ Database:&lt;/b&gt; Kết nối mã hóa SSL qua cổng 5432/6543 của PostgreSQL. Prisma Client quản lý Connection Pool tự động, chống tràn RAM.&#xa;5. &lt;b&gt;Môi trường Dev/Staging (Docker Compose):&lt;/b&gt; Toàn bộ hệ thống có thể chạy cục bộ 1-click bằng file `docker-compose.yml` với mạng nội bộ `brewlite_network`." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#1e293b;fontSize=11;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="800" width="1720" height="120" as="geometry" />
        </mxCell>

        <!-- ==================== CÁC ĐƯỜNG KẾT NỐI MẠNG (COMMUNICATION PATHS) ==================== -->

        <!-- 1. Browser to Vercel (HTTPS 443) -->
        <mxCell id="conn_user_vercel" value="&lt;&lt;protocol: HTTPS&gt;&gt;&#xa;Port 443 (TLS 1.3)&#xa;Download Web Assets &amp; SSR" style="endArrow=classic;startArrow=classic;html=1;rounded=0;strokeColor=#16a34a;strokeWidth=2;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;" edge="1" parent="1" source="node_client" target="node_vercel">
          <mxGeometry y="25" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- 2. Browser to NestJS API (HTTPS 443 REST API + JWT + Idempotency) -->
        <mxCell id="conn_user_api" value="&lt;&lt;protocol: HTTPS REST API&gt;&gt;&#xa;Port 443 / JSON Payload&#xa;Headers: [Bearer JWT, X-Idempotency-Key]" style="endArrow=classic;startArrow=classic;html=1;rounded=0;strokeColor=#2563eb;strokeWidth=2.5;edgeStyle=orthogonalEdgeStyle;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;" edge="1" parent="1" source="node_client" target="node_backend">
          <mxGeometry x="-0.15" y="-20" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="190" y="80" />
              <mxPoint x="1090" y="80" />
            </Array>
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- 3. NestJS API to PostgreSQL Database (TCP / SSL Port 5432) -->
        <mxCell id="conn_api_db" value="&lt;&lt;protocol: TCP / PostgreSQL Wire&gt;&gt;&#xa;Port 5432 / 6543 (sslmode=require)&#xa;Prisma Query Engine &amp; Connection Pool" style="endArrow=classic;startArrow=classic;html=1;rounded=0;strokeColor=#7c3aed;strokeWidth=2.5;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;" edge="1" parent="1" source="node_backend" target="node_db">
          <mxGeometry y="-25" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- 4. NestJS API to Mock Payment Gateway (HTTPS REST Webhook) -->
        <mxCell id="conn_api_pay" value="&lt;&lt;protocol: HTTPS REST&gt;&gt;&#xa;Port 443 / Webhook Mock" style="endArrow=classic;startArrow=classic;html=1;rounded=0;strokeColor=#d946ef;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;exitX=0;exitY=0.9;exitDx=0;exitDy=0;exitPerimeter=0;" edge="1" parent="1" source="node_backend" target="node_external">
          <mxGeometry x="0.1" y="20" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
