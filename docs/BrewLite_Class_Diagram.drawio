        <!-- Legend Note -->
        <mxCell id="legend_note" value="&lt;b&gt;GHI CHÚ QUAN HỆ UML:&lt;/b&gt;&#xa;• &lt;b&gt;1 - 0..1:&lt;/b&gt; Account ↔ Customer/Staff (1 Tài khoản có tối đa 1 hồ sơ Khách/Nhân viên)&#xa;• &lt;b&gt;1 - 0..*:&lt;/b&gt; Customer → Order; Order → Payment; Order → OrderStatusHistory&#xa;• &lt;b&gt;1 - 1..*:&lt;/b&gt; Product → ProductVariant; Order → OrderItem&#xa;• &lt;b&gt;N - N (Qua Bảng liên kết):&lt;/b&gt; Order ↔ ProductVariant (OrderItem); ProductVariant ↔ Ingredient (Recipe)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#1e293b;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="grp_enums">
          <mxGeometry x="20" y="235" width="560" height="75" as="geometry" />
        </mxCell>

